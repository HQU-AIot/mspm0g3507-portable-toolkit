{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MSPM0G3507: OpenOCD Debug",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${input:firmwarePath}",
      "servertype": "openocd",
      "serverpath": "${workspaceFolder}/vendor/openocd/1.3.1.50/bin/openocd.exe",
      "armToolchainPath": "${workspaceFolder}/vendor/arm-none-eabi-gdb/14.2.rel1.1",
      "searchDir": ["${workspaceFolder}/vendor/openocd/1.3.1.50/share/openocd/scripts"],
      "configFiles": ["interface/cmsis-dap.cfg", "target/ti_mspm0.cfg"],
      "runToEntryPoint": "main",
      "showDevDebugOutput": "none"
    }
  ],
  "inputs": [
    {
      "id": "firmwarePath",
      "type": "promptString",
      "description": "待调试 .out/.elf 文件的绝对路径"
    }
  ]
}
